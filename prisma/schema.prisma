generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id String @id @default(uuid())

  // Basic Info
  fullName String
  email    String @unique
  phone    String @unique
  password String

  // Profile
  gender       Gender?
  age          Int?
  bloodGroup   BloodGroup
  address      String?
  city         String?
  district     String?
  profileImage String?
  bio          String?
  dateOfbirth  DateTime?

  // Donor Info
  isDonor          Boolean   @default(true)
  availability     Boolean   @default(true)
  weight           Float?
  lastDonationDate DateTime?

  // Account
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  requestedBlood bloodRequest[] @relation("Requester")
  donatedBlood   bloodRequest[] @relation("Donor")
  inventories    inventory[]

  @@map("users")
}

model bloodRequest {
  id String @id @default(uuid())

  requesterId String

  donorId     String?
  inventoryId String?

  patientName String
  patientAge  Int?

  bloodGroup    BloodGroup
  unitsRequired Int

  hospitalName    String
  hospitalAddress String

  contactPerson String
  contactPhone  String

  reason String?

  requiredDate DateTime

  status RequestStatus @default(PENDING)

  requester user @relation("Requester", fields: [requesterId], references: [id])

  donor user? @relation("Donor", fields: [donorId], references: [id])

  inventory inventory? @relation(fields: [inventoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blood_requests")
}

model inventory {
  id String @id @default(uuid())

  bloodGroup BloodGroup
  requests   bloodRequest[]

  // Blood Unit Information
  bagNumber  String @unique
  quantityML Int

  donorName String?

  donorId String?

  collectionDate DateTime
  expiryDate     DateTime

  // Lab Testing
  testStatus     TestStatus @default(PENDING)
  hivTest        TestResult @default(PENDING)
  hepatitisBTest TestResult @default(PENDING)
  hepatitisCTest TestResult @default(PENDING)
  malariaTest    TestResult @default(PENDING)
  syphilisTest   TestResult @default(PENDING)

  isAvailable Boolean @default(true)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inventories")
}

enum Role {
  USER
  OPERATOR
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum TestStatus {
  PENDING
  TESTED
  FAILED
}

enum TestResult {
  PENDING
  NEGATIVE
  POSITIVE
}
